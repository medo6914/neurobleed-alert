# ============================================
# NeuroBleed Alert - Environment Configuration
# ============================================
# Copy to .env for local development, or set these as Railway service variables.
# Production MUST use PostgreSQL (sqlite is only accepted when ENVIRONMENT=development).

# --- Core (REQUIRED in production) ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-very-long-random-string
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://localhost:6379/0

# --- Maps (free, keyless OpenStreetMap stack - no signup, no API key) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_SEARCH_REGION=Cairo, Egypt

# --- Weather (free tier: https://openweathermap.org/api - email signup) ---
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric

# --- Firebase Admin SDK (https://console.firebase.google.com) ---
# Download a service-account JSON key and mount it at this path (e.g. Railway Volume).
FIREBASE_CREDENTIALS_PATH=./credentials/firebase.json
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# --- SMS / WhatsApp ---
# Twilio (trial: https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890
# Vonage (trial: https://dashboard.nexmo.com - email signup)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_PHONE_NUMBER=

# --- Email (pick one provider) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@neurobleed.com
RESEND_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- AI / LLM (chain: Ollama local (free, no key) -> OpenAI -> Gemini -> HuggingFace) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
HUGGINGFACE_API_KEY=your-hf-token
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Payments (all sandbox/test modes) ---
# Stripe (test mode: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paymob (test mode: https://accept.paymob.com)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
# PayPal (sandbox: https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- File storage (Cloudinary free tier: https://cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Monitoring ---
# Sentry (free 5k events: https://sentry.io)
SENTRY_DSN=

# --- Medical data (optional, free) ---
# PubMed E-utilities (rate-limit courtesy; not required)
PUBMED_EMAIL=ai@neurobleed.com
PUBMED_API_KEY=