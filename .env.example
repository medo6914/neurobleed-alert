# ============================================
# NeuroBleed Alert - Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# --- Backend ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-very-long-random-string
DATABASE_URL=postgresql://neurobleed:neurobleed_dev@localhost:5432/neurobleed
REDIS_URL=redis://localhost:6379/0

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=./credentials/firebase.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# --- Twilio ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_EMERGENCY_PHONE=+1234567890

# --- AI ---
OPENAI_API_KEY=your-openai-api-key
MODEL_PATH=./models/risk_model.pkl
LLM_MODEL=mistral-7b

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@neurobleed.com

# --- Database Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_BACKUP_BUCKET=neurobleed-backups

# --- Monitoring ---
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Hardware ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Documentation ---
PDF_REPORT_URL=https://docs.neurobleed.com/reports
