# ============================================
# NeuroBleed Alert - Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# NOTE: .env files are NEVER committed (see .gitignore)

# --- Core / Backend ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-very-long-random-string
DATABASE_URL=postgresql+asyncpg://neurobleed:neurobleed_dev@localhost:5432/neurobleed
REDIS_URL=redis://localhost:6379/0

# --- Maps (free, keyless OpenStreetMap stack - no signup, no API key) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_SEARCH_REGION=Cairo, Egypt

# --- Weather (free tier: https://openweathermap.org/api - email signup) ---
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric

# --- Firebase (https://console.firebase.google.com) ---
FIREBASE_CREDENTIALS_PATH=./credentials/firebase.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# --- SMS / WhatsApp ---
# Twilio (trial: https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_EMERGENCY_PHONE=+1234567890
# Vonage (trial: https://dashboard.nexmo.com - email signup)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_PHONE_NUMBER=

# --- Email (pick one provider) ---
# SMTP (any provider; Gmail needs an app password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@neurobleed.com
ALERT_EMAIL=alerts@neurobleed.com
# Resend (free 100/day: https://resend.com)
RESEND_API_KEY=
# SendGrid (free 100/day: https://sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- AI / LLM (chain: Ollama local (free, no key) -> OpenAI -> Gemini -> HuggingFace) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
HUGGINGFACE_API_KEY=your-hf-token
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
MODEL_PATH=./models/risk_model.pkl

# --- Payments (all free sandbox modes) ---
# Stripe (test mode: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paymob (test mode: https://accept.paymob.com)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
# PayPal (sandbox: https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- File storage (Cloudinary free tier: https://cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Monitoring ---
# Sentry (free 5k events: https://sentry.io)
SENTRY_DSN=your-sentry-dsn
# UptimeRobot (free 50 monitors: https://uptimerobot.com) - monitor the /health endpoint
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Database Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_BACKUP_BUCKET=neurobleed-backups

# --- Hardware ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Documentation ---
PDF_REPORT_URL=https://docs.neurobleed.com/reports
