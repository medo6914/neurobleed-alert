int _sensorReadingCollectionEstimateSize(
  SensorReadingCollection object,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  var bytesCount = offsets.last;
  bytesCount += 3 + object.deviceId.length * 3;
  bytesCount += 3 + object.id.length * 3;
  bytesCount += 3 + object.patientId.length * 3;
  return bytesCount;
}

void _sensorReadingCollectionSerialize(
  SensorReadingCollection object,
  IsarWriter writer,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  writer.writeDouble(offsets[0], object.cpp);
  writer.writeString(offsets[1], object.deviceId);
  writer.writeDouble(offsets[2], object.diastolicBP);
  writer.writeDouble(offsets[3], object.heartRate);
  writer.writeDouble(offsets[4], object.icp);
  writer.writeString(offsets[5], object.id);
  writer.writeDouble(offsets[6], object.motionArtifact);
  writer.writeDouble(offsets[7], object.oxygenSaturation);
  writer.writeString(offsets[8], object.patientId);
  writer.writeDateTime(offsets[9], object.receivedAt);
  writer.writeDouble(offsets[10], object.respiratoryRate);
  writer.writeDouble(offsets[11], object.riskScore);
  writer.writeLong(offsets[12], object.signalQuality);
  writer.writeDouble(offsets[13], object.systolicBP);
  writer.writeDouble(offsets[14], object.temperature);
  writer.writeDateTime(offsets[15], object.timestamp);
}

